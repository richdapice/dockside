{
  "manifest_version": 3,
  "name": "Dockside",
  "version": "0.1.0",
  "description": "Tabs you leave become apps; a second tab from the same site turns the app into a folder.",
  "permissions": ["tabs", "storage", "sidePanel", "favicon", "tabGroups"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "panel.html" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Open Dockside", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "commands": {
    "toggle-panel": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Open or close the Dockside panel"
    }
  }
}
